enum message_status_enum {
  processing
  completed
  canceled
}

enum export_status_enum {
  exporting
  completed
  failed
}

enum import_status_enum {
  importing
  completed
  failed
}

enum file_type_enum {
  file
  folder
}

table conversations {
  id bigint [pk, not null]
  project_id bigint [not null]
  title varchar(255) [not null]
  updated_at timestamp [not null, default: `now()`]
  created_at timestamp [not null, default: `now()`]

  indexes {
    project_id [name: 'conversations_project_id_idx']
  }
}

table messages {
  id bigint [pk, not null]
  project_id bigint [not null]
  conversation_id bigint [not null]
  content text [not null]
  message_status message_status_enum
  role role_enum [not null]
  updated_at timestamp [not null, default: `now()`]
  created_at timestamp [not null, default: `now()`]

  indexes {
    project_id [name: 'messages_project_id_idx']
    conversation_id [name: 'messages_conversation_id_idx']
  }
}

table projects {
  id bigint [pk, not null]
  user_id bigint [not null]
  name varchar(255) [not null]
  import_status import_status_enum
  export_status export_status_enum
  export_repo_url varchar(255)
  storage_used bigint [not null, default: `0`]
  sandbox_id varchar(255)
  updated_at timestamp [not null, default: `now()`]
  created_at timestamp [not null, default: `now()`]

  indexes {
    user_id [name: 'projects_user_id_idx']
  }
}

table files {
  id bigint [pk, not null]
  project_id bigint [not null]
  parent_id bigint
  name varchar(255) [not null]
  type file_type_enum [not null]
  storage_key uuid [default: `gen_random_uuid()`]
  version integer [not null, default: 1]
  updated_at timestamp [not null, default: `now()`]
  created_at timestamp [not null, default: `now()`]

  indexes {
    project_id [name: 'files_project_id_idx']
    parent_id [name: 'files_parent_id_idx']
    (project_id, parent_id) [name: 'files_project_parent_idx']
    (project_id, parent_id, type) [name: 'files_project_parent_type_idx']
    (project_id, parent_id, name) [name: 'files_unique_name_per_folder_idx', unique]
  }
}

table users {
  id bigint [pk, not null]
  username varchar(50) [not null, unique]
  email varchar(255) [not null, unique]
  password varchar(255) [not null]
  mobile varchar(20)
  country varchar(50)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

ref: conversations.project_id > projects.id

ref: messages.conversation_id > conversations.id

ref: messages.project_id - projects.id

ref: projects.user_id > users.id

ref: files.project_id > projects.id

ref: files.parent_id > files.id