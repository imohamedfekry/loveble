DATABASE_URL="postgresql://postgres:1@localhost:5432/loveble"
NODE_ENV=development
PORT=3001
CORS_ORIGIN=https://loveble.app,http://localhost:3000
WS_CORS_ORIGINS=https://loveble.app,http://localhost:3000
# Share auth cookies between loveble.app, api.* and preview subdomains.
AUTH_COOKIE_DOMAIN=.loveble.app
# Public previews (nginx routes <projectId>.loveble.app to the backend)
PREVIEW_BASE_DOMAIN=loveble.app
PREVIEW_PUBLIC_SCHEME=https
# JWT
JWT_SECRET_ACCESS=
JWT_EXPIRES_IN=7d
JWT_SECRET_REFRESH=
JWT_REFRESH_EXPIRES_IN=30d
JWT_TEMP=
OAUTH_TOKEN=
# Encryption
ENCRYPTION_KEY=
ENCRYPTION_ALGORITHM=aes-256-cbc
ENCRYPTION_IV=
# HASH
PEPPER=
# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
# GitHub OAuth
GITHUB_CLIENT_ID=Ov23litQN2sa8bHjP34b
GITHUB_CLIENT_SECRET=
OAUTH_CALLBACK_URL=https://loveble.app/callback
# S3 - Storage
S3_ENDPOINT=http://localhost:19000
S3_REGION=us-east-1

S3_ACCESS_KEY=
S3_SECRET_KEY=

S3_BUCKET=squadra
S3_FORCE_PATH_STYLE=true
S3_LIVE_BUCKET=squadra-live


# walgit (self-hosted git server)
WALGIT_BASE_URL=http://walgit:8080
WALGIT_TOKEN_ME=
# e2b (sandbox)
E2B_API_KEY=
E2B_SANDBOX_TIMEOUT_MS=3600000
E2B_TEMPLATE=loveble-tanstack-start
# Email
RESEND_API_KEY=
# AI APIs — managed by Bifrost
BIFROST_BASE_URL=http://localhost:8081
BIFROST_VIRTUAL_KEY=2886c2714a924ff486a63d3728534a85.IWKYYp9esfhW42k7NuFfVVFj
# Bifrost
BIFROST_ENCRYPTION_KEY=
BIFROST_SETUP_TOKEN=
# Mastra storage (agent memory lives in its own Postgres schema)
MASTRA_SCHEMA=mastra
# inngest
INNGEST_SECRET=
INNGEST_SIGNING_KEY=
INNGEST_WEBHOOK_SECRET=
